{
  "dependencies": {
    "firebase": "^12.9.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.58.2",
    "firebase-tools": "15.31.0"
  },
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node dev-lab/start.cjs",
    "check": "node scripts/check.cjs",
    "test": "npm run check && node --test tests/*.test.cjs",
    "build:dev": "node scripts/build-dev.cjs",
    "test:lab": "playwright test",
    "doctor": "node scripts/doctor.cjs",
    "test:all": "npm test && npm run test:lab"
  }
}
