{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('platformAdmins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('platformAdmins').child(auth.uid).val() === true)",
        ".validate": "!newData.child('role').exists() || newData.child('role').val() === 'player' || newData.child('role').val() === data.child('role').val() || (auth != null && root.child('platformAdmins').child(auth.uid).val() === true)"
      }
    },
    "games": {
      ".read": "auth != null",
      ".indexOn": [
        "createdBy",
        "createdAt",
        "partyCode"
      ],
      "$gameId": {
        ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && ((data.exists() && (newData.exists() || data.child('createdBy').val() === auth.uid)) || (newData.child('createdBy').val() === auth.uid && newData.child('unlockId').isString() && root.child('accountGameUnlocks').child(auth.uid).child(newData.child('unlockId').val()).child('storyId').val() === newData.child('storyId').val() && root.child('accountGameUnlocks').child(auth.uid).child(newData.child('unlockId').val()).child('gameMode').val() === newData.child('gameMode').val() && root.child('gameUnlockKeys').child(root.child('accountGameUnlocks').child(auth.uid).child(newData.child('unlockId').val()).child('key').val()).child('ownerUid').val() === auth.uid && root.child('gameUnlockKeys').child(root.child('accountGameUnlocks').child(auth.uid).child(newData.child('unlockId').val()).child('key').val()).child('active').val() === true))",
        ".validate": "(!data.exists() || (newData.child('createdBy').val() === data.child('createdBy').val() && newData.child('storyId').val() === data.child('storyId').val() && newData.child('unlockId').val() === data.child('unlockId').val() && newData.child('gameMode').val() === data.child('gameMode').val())) && (!data.exists() || data.child('createdBy').val() === auth.uid || (newData.child('state/experience').exists() === data.child('state/experience').exists() && newData.child('state/experience/schemaVersion').val() === data.child('state/experience/schemaVersion').val() && newData.child('state/experience/revision').val() === data.child('state/experience/revision').val() && newData.child('state/experience/stepId').val() === data.child('state/experience/stepId').val() && newData.child('state/experience/startedAt').val() === data.child('state/experience/startedAt').val() && newData.child('state/experience/pausedAt').val() === data.child('state/experience/pausedAt').val())) && (!data.exists() || data.child('createdBy').val() === auth.uid || newData.child('privateGeneration').val() === data.child('privateGeneration').val())",
        "players": {
          "$uid": {
            "inventory": {
              ".validate": false
            }
          }
        },
        "state": {
          "itemAssignments": {
            ".validate": false
          }
        }
      }
    },
    "partyCodeIndex": {
      ".read": true,
      ".write": "auth != null"
    },
    "venues": {
      ".read": true,
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true"
    },
    "cancelledGames": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true"
    },
    "adminInvites": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true"
    },
    "photos": {
      ".read": "auth != null",
      ".write": false
    },
    "scans": {
      ".read": "auth != null",
      ".write": false
    },
    "scanLog": {
      ".read": "auth != null",
      ".write": false
    },
    "survey": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": false
    },
    "activeItems": {
      ".read": "auth != null",
      ".write": false
    },
    "bathroomScans": {
      ".read": "auth != null",
      ".write": false
    },
    "memoryReset": {
      ".read": "auth != null",
      ".write": false
    },
    "appVersion": {
      ".read": "auth != null",
      ".write": false
    },
    "testMode": {
      ".read": "auth != null",
      ".write": false
    },
    "$other": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": false
    },
    "hostAccess": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "hostAccessRequests": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "(auth != null && root.child('platformAdmins').child(auth.uid).val() === true) || (auth != null && auth.uid === $uid)",
        ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['email','displayName','requestedAt'])",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "requestedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "gameUnlockKeys": {
      "$key": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous'",
        ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && data.exists() && data.child('active').val() === true && (!data.child('ownerUid').exists() || data.child('ownerUid').val() === auth.uid) && newData.child('ownerUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['id','storyId','gameMode','active','issuedAt','ownerUid','claimedAt'])",
        "id": {
          ".validate": "newData.val() === data.val()"
        },
        "storyId": {
          ".validate": "newData.val() === data.val()"
        },
        "gameMode": {
          ".validate": "newData.val() === data.val()"
        },
        "active": {
          ".validate": "newData.val() === data.val()"
        },
        "issuedAt": {
          ".validate": "newData.val() === data.val()"
        },
        "ownerUid": {
          ".validate": "newData.val() === auth.uid"
        },
        "claimedAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "accountGameUnlocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$unlockId": {
          ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && auth.uid === $uid",
          ".validate": "newData.hasChildren(['key','storyId','gameMode','claimedAt']) && root.child('gameUnlockKeys').child(newData.child('key').val()).child('id').val() === $unlockId && root.child('gameUnlockKeys').child(newData.child('key').val()).child('ownerUid').val() === auth.uid && root.child('gameUnlockKeys').child(newData.child('key').val()).child('active').val() === true && root.child('gameUnlockKeys').child(newData.child('key').val()).child('storyId').val() === newData.child('storyId').val() && root.child('gameUnlockKeys').child(newData.child('key').val()).child('gameMode').val() === newData.child('gameMode').val()",
          "key": {
            ".validate": "newData.isString() && newData.val().length === 16"
          },
          "storyId": {
            ".validate": "newData.isString()"
          },
          "gameMode": {
            ".validate": "newData.isString()"
          },
          "claimedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "hostInvitations": {
      "$gameId": {
        ".read": "auth != null && root.child('games').child($gameId).child('createdBy').val() === auth.uid",
        ".write": "auth != null && root.child('games').child($gameId).child('createdBy').val() === auth.uid",
        "$inviteId": {
          ".validate": "newData.hasChildren(['name','email','addedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "addedAt": {
            ".validate": "newData.isNumber()"
          },
          "sentAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          "playerUid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          }
        }
      }
    },
    "developerAccess": {
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email_verified === true"
      }
    },
    "platformAdmins": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "privateSessions": {
      ".read": false,
      ".write": false,
      "$gameId": {
        ".read": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && root.child('games').child($gameId).exists() && (root.child('games').child($gameId).child('createdBy').val() === auth.uid || (auth.token.email_verified === true && root.child('developerAccess').child(auth.uid).child('inspectAllCharacters').val() === true))",
        ".write": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && root.child('games').child($gameId).exists() && (root.child('games').child($gameId).child('createdBy').val() === auth.uid)",
        ".validate": "newData.child('schemaVersion').val() === 1 && newData.child('generation').val() === (root.child('games').child($gameId).child('privateGeneration').exists() ? root.child('games').child($gameId).child('privateGeneration').val() : 0)",
        "players": {
          "$uid": {
            ".read": "(auth != null && auth.token.firebase.sign_in_provider !== 'anonymous') && auth.uid === $uid && root.child('games').child($gameId).child('players').child(auth.uid).exists()"
          }
        }
      }
    }
  }
}
